# Backend
DATABASE_URL="postgresql://zabota_local:zabota_local_only@127.0.0.1:55432/zabota_rehearsal?schema=public"
PORT=4000
JWT_SECRET="replace-with-a-long-random-secret"
ACCESS_TOKEN_TTL_MINUTES=10
REFRESH_SESSION_DAYS=30
REFRESH_IDLE_DAYS=7
ADMIN_ACCESS_TOKEN_TTL_MINUTES=5
ADMIN_REFRESH_SESSION_HOURS=8
ADMIN_REFRESH_IDLE_MINUTES=30
TEMPORARY_PASSWORD_TTL_HOURS=24
CORS_ORIGIN="http://localhost:5173"
UPLOADS_DIR=backend/uploads

# Public map key for future Yandex Maps integration.
# For frontend local Vite usage duplicate it as VITE_YANDEX_MAPS_API_KEY.
YANDEX_MAPS_API_KEY=""
VITE_YANDEX_MAPS_API_KEY=""

# Product defaults. City settings can override these values.
DEFAULT_SERVICE_FEE_AMOUNT=50
DEFAULT_MIN_TOP_UP_AMOUNT=150
TRIAL_BALANCE_ENABLED=false
TRIAL_BALANCE_AMOUNT=100

# Payments. Development uses mock by default. Card data is entered only on the bank payment page.
PAYMENT_PROVIDER=mock
PAYMENT_RECEIPT_ENABLED=false
ALLOW_LEGACY_MOCK_TOP_UP=false
TBANK_TERMINAL_MODE=test
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_API_URL=https://securepay.tinkoff.ru/v2
TBANK_SUCCESS_URL=http://localhost:4000/app/balance/payment-success
TBANK_FAIL_URL=http://localhost:4000/app/balance/payment-fail
TBANK_NOTIFICATION_URL=http://localhost:4000/api/payments/tbank/webhook

# VK ID OAuth 2.1. Keep disabled until the app and redirect URI are configured in VK ID.
OAUTH_ENABLED=false
VK_ID_ENABLED=false
VK_ID_CLIENT_ID=
VK_ID_CLIENT_SECRET=
VK_ID_REDIRECT_URI=http://localhost:4000/api/auth/oauth/vk/callback
VK_ID_SUCCESS_REDIRECT_PATH=/app/oauth/complete
VK_ID_FAIL_REDIRECT_PATH=/app/login?oauthError=vk
VISIT_RECONCILIATION_ENABLED=true
VISIT_RECONCILIATION_INTERVAL_MINUTES=15
VISIT_RECONCILIATION_RUN_ON_STARTUP=true

# OpenAPI is enabled by default outside production. Production defaults are false unless explicitly enabled.
OPENAPI_JSON_ENABLED=true
SWAGGER_UI_ENABLED=true
