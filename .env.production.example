NODE_ENV=production
PORT=4000

APP_BASE_URL=https://zabota-ugorsk.ru
PUBLIC_SITE_URL=https://zabota-ugorsk.ru

DATABASE_URL="postgresql://zabota_app:CHANGE_ME@postgres:5432/zabota?schema=public"
POSTGRES_USER=zabota_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=zabota
APP_ENV_FILE=.env.production
APP_HOST_PORT=4000
ZABOTA_DATA_PATH=/opt/zabota/data

JWT_SECRET="replace-with-long-random-production-secret"
ACCESS_TOKEN_TTL_MINUTES=10
REFRESH_SESSION_DAYS=30
REFRESH_IDLE_DAYS=7
ADMIN_ACCESS_TOKEN_TTL_MINUTES=5
ADMIN_REFRESH_SESSION_HOURS=8
ADMIN_REFRESH_IDLE_MINUTES=30
TEMPORARY_PASSWORD_TTL_HOURS=24

CORS_ORIGIN="https://zabota-ugorsk.ru"

YANDEX_MAPS_API_KEY=""
VITE_YANDEX_MAPS_API_KEY=""

DEFAULT_SERVICE_FEE_AMOUNT=50
DEFAULT_MIN_TOP_UP_AMOUNT=150
TRIAL_BALANCE_ENABLED=false
TRIAL_BALANCE_AMOUNT=100

# Current production mode. Copy this file only after terminal credentials and webhook are verified.
PAYMENT_PROVIDER=tbank
PAYMENT_RECEIPT_ENABLED=false
ALLOW_LEGACY_MOCK_TOP_UP=false
TBANK_TERMINAL_MODE=live

SEED_DEMO_DATA=false
PRODUCTION_ADMIN_EMAIL=
PRODUCTION_ADMIN_PASSWORD=
PRODUCTION_ADMIN_PHONE=

TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_API_URL=https://securepay.tinkoff.ru/v2
TBANK_SUCCESS_URL=https://zabota-ugorsk.ru/app/balance/payment-success
TBANK_FAIL_URL=https://zabota-ugorsk.ru/app/balance/payment-fail
TBANK_NOTIFICATION_URL=https://zabota-ugorsk.ru/api/payments/tbank/webhook

UPLOADS_DIR=/data/uploads

OAUTH_ENABLED=false
VK_ID_ENABLED=false
VK_ID_CLIENT_ID=
VK_ID_CLIENT_SECRET=
VK_ID_REDIRECT_URI=https://zabota-ugorsk.ru/api/auth/oauth/vk/callback
VK_ID_SUCCESS_REDIRECT_PATH=/app/oauth/complete
VK_ID_FAIL_REDIRECT_PATH=/app/login?oauthError=vk
VISIT_RECONCILIATION_ENABLED=true
VISIT_RECONCILIATION_INTERVAL_MINUTES=15
VISIT_RECONCILIATION_RUN_ON_STARTUP=true
