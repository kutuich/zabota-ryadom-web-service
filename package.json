{
  "name": "zabota-ryadom-web-service",
  "version": "0.1.0",
  "private": true,
  "description": "Zabota Ryadom 2.0 web application",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "start": "npm run start:prod",
    "start:prod": "node scripts/start-preview.mjs",
    "build": "npm run build -w backend && npm run build -w frontend",
    "check": "npm run check -w backend && npm run check -w frontend",
    "test": "npm run test -w backend && npm run test -w frontend",
    "api:openapi": "npm run api:openapi -w backend",
    "auth:credential-inventory": "npm run auth:credential-inventory -w backend",
    "visual:audit": "node scripts/visual-audit.mjs",
    "db:generate": "npm run db:generate:postgres && npm run db:generate:sqlite-source",
    "db:generate:postgres": "prisma generate --schema backend/prisma/schema.prisma",
    "db:generate:sqlite-source": "prisma generate --schema backend/prisma/sqlite-source/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema backend/prisma/schema.prisma",
    "db:migrate:status": "prisma migrate status --schema backend/prisma/schema.prisma",
    "db:rehearsal:transfer": "node --import tsx backend/src/scripts/migrateSqliteToPostgres.ts",
    "db:rehearsal:verify": "node --import tsx backend/src/scripts/verifySqliteToPostgres.ts",
    "db:smoke:postgres": "node --import tsx backend/src/scripts/postgresApplicationSmoke.ts",
    "db:seed": "node --import tsx backend/prisma/seed.ts",
    "db:seed-service-tree-v3": "node --import tsx backend/prisma/seedServiceTreeV3.ts",
    "db:seed-demo": "node --import tsx backend/prisma/seedDemo.ts",
    "db:reset-demo": "node --import tsx backend/prisma/resetDemo.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "^1.61.1",
    "prisma": "^6.1.0",
    "vitest": "^3.2.4"
  }
}
