DATABASE_URL=file:/data/zabota.db
PORT=4000
JWT_SECRET=replace-with-a-long-random-local-secret
CORS_ORIGIN=http://localhost:4000
YANDEX_MAPS_API_KEY=
VITE_YANDEX_MAPS_API_KEY=
DEFAULT_COMMISSION_AMOUNT=50
DEFAULT_MIN_TOP_UP_AMOUNT=150
PAYMENT_PROVIDER=mock
PAYMENT_RECEIPT_ENABLED=false

# Demo users are created only when this value is explicitly changed to true.
SEED_DEMO_DATA=false

# Fill these values in .env.local.docker. Do not commit that file.
PRODUCTION_ADMIN_EMAIL=
PRODUCTION_ADMIN_PASSWORD=
PRODUCTION_ADMIN_PHONE=
PRODUCTION_ADMIN_DISPLAY_NAME=Локальный администратор

TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_API_URL=https://securepay.tinkoff.ru/v2
TBANK_SUCCESS_URL=http://localhost:4000/app/balance/payment-success
TBANK_FAIL_URL=http://localhost:4000/app/balance/payment-fail
TBANK_NOTIFICATION_URL=http://localhost:4000/api/payments/tbank/webhook
