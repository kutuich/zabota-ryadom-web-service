  documentType        String
  documentVersion     String
  documentTitle       String
  documentContentHash String
  acceptedAt          DateTime      @default(now())
  ipAddress           String?
  userAgent           String?
  source              String        @default("profile")
  isRequired          Boolean       @default(true)
  isActive            Boolean       @default(true)
  revokedAt           DateTime?
  revocationReason    String?
  createdAt           DateTime      @default(now())
  user                User          @relation("UserLegalConsents", fields: [userId], references: [id], onDelete: Cascade)
  document            LegalDocument @relation(fields: [documentId], references: [id])

  @@unique([userId, documentId])
  @@index([userId, isActive])
  @@index([documentType, documentVersion])
}

model UserConsentAuditLog {
  id              String   @id @default(cuid())
  userId          String?
  adminId         String?
  action          String
  documentType    String?
  documentVersion String?
  oldValue        String?
  newValue        String?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())
  comment         String?
  user            User?    @relation("UserConsentAuditLogs", fields: [userId], references: [id], onDelete: SetNull)
  admin           User?    @relation("AdminConsentAuditLogs", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([adminId, createdAt])
  @@index([documentType, documentVersion])
}

model ConsentExportLog {
  id                String   @id @default(cuid())
  exportedByAdminId String?
  exportType        String
  userId            String?
  fileName          String
  exportedAt        DateTime @default(now())
  ipAddress         String?
  userAgent         String?
  comment           String?
  exportedByAdmin   User?    @relation("AdminConsentExports", fields: [exportedByAdminId], references: [id], onDelete: SetNull)
  user              User?    @relation("UserConsentExports", fields: [userId], references: [id], onDelete: SetNull)

  @@index([exportedByAdminId, exportedAt])
  @@index([userId, exportedAt])
  @@index([exportType])
}

model PerformerDocument {
  id           String    @id @default(cuid())
  performerId  String
  type         String
  fileName     String
  fileUrl      String
  originalFileName String?
  storagePath  String?
  mimeType     String?
  fileSize     Int?
  checksum     String?
  status       String    @default("uploaded")
  uploadedAt   DateTime  @default(now())
  verifiedAt   DateTime?
  adminComment String?
  performer    User      @relation(fields: [performerId], references: [id], onDelete: Cascade)

  @@index([performerId, type])
  @@index([status])
}

model ServiceSetting {
  key       String   @id
  valueJson String
  label     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt
}

model KnowledgeArticle {
  id          String   @id @default(cuid())
  audience    String   @default("all")
  title       String
  slug        String   @unique
  content     String
  category    String
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([audience, isPublished])
  @@index([category, sortOrder])
}
