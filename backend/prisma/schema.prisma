generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Region {
  id                 String              @id @default(cuid())
  name               String              @unique
  slug               String              @unique
  status             String              @default("active")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  cities             City[]
  categoryStructures CategoryStructure[]
  broadcastCampaigns  BroadcastCampaign[]
}

model City {
  id                      String          @id @default(cuid())
  name                    String
  normalizedName          String          @default("")
  slug                    String          @unique
  type                    String          @default("city")
  region                  String
  regionId                String?
  district                String?
  municipalDistrict       String?
  fiasId                  String?         @unique
  garId                   String?         @unique
  source                  String          @default("seed")
  directoryStatus         String          @default("directory")
  serviceStatus           String          @default("inactive")
  activatedAt             DateTime?
  activatedByUserId       String?
  status                  String          @default("active")
  isActive                Boolean         @default(true)
  defaultCommissionAmount Int             @default(50)
  minTopUpAmount          Int             @default(150)
  mapCenterLat            Float
  mapCenterLng            Float
  mapDefaultRadiusMeters  Int             @default(600)
  districtsJson           String          @default("[]")
  localSettingsJson       String          @default("{}")
  timezone                String          @default("Asia/Yekaterinburg")
  pricingZone             String          @default("base_yugorsk")
  sortOrder               Int             @default(100)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  users                   User[]
  userCities              UserCity[]
  activatedByUser         User?           @relation("CityActivatedBy", fields: [activatedByUserId], references: [id], onDelete: SetNull)
  requests                ClientRequest[]
  regionRecord            Region?         @relation(fields: [regionId], references: [id], onDelete: SetNull)
  categoryStructures      CategoryStructure[]
  helperCategoryPreferences HelperCategoryPreference[]
  broadcastCampaigns       BroadcastCampaign[]
  requestDrafts            RequestDraft[]

  @@index([isActive])
  @@index([normalizedName])
  @@index([region])
  @@index([regionId])
  @@index([directoryStatus, serviceStatus])
  @@index([activatedByUserId])
}

model AuthSession {
  id                  String   @id @default(cuid())
  familyId            String
  userId              String
  tokenHash           String   @unique
  actingRole          String?
  createdAt           DateTime @default(now())
  lastUsedAt          DateTime @default(now())
  expiresAt           DateTime
  idleExpiresAt       DateTime
  rotatedAt           DateTime?
  revokedAt           DateTime?
  revokeReason        String?
  replacedBySessionId String?
  ipAddress           String?
  userAgent           String?
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

model User {
  id                       String               @id @default(cuid())
  role                     String
  rolesJson                String               @default("[]")
  phone                    String?              @unique
  normalizedPhone          String?              @unique
  email                    String?              @unique
  passwordHash             String?
  authTokenVersion         Int                  @default(0)
  mustChangePassword       Boolean              @default(false)
  temporaryPasswordExpiresAt DateTime?
  passwordChangedAt        DateTime?
  passwordResetAt          DateTime?
  passwordResetByUserId    String?
  lastLoginAt              DateTime?
  displayNameChangedAt     DateTime?
  displayName              String
  avatarUrl                String?
  cityId                   String?
  status                   String               @default("active")
  balance                  Int                  @default(0)
  bonusBalance             Int                  @default(0)
  isPhoneVerified          Boolean              @default(false)
  isEmailVerified          Boolean              @default(false)
  phoneVerifiedAt          DateTime?
  emailVerifiedAt          DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  blockedAt                DateTime?
  blockedByAdminId         String?
  blockedByRole            String?
  blockReason              String?
  roleBeforeManager        String?
  managerAssignedAt        DateTime?
  managerAssignedByAdminId String?
  managerRevokedAt         DateTime?
  managerRevokedByAdminId  String?
  archiveRequestedAt       DateTime?
  archiveRequestedByAdminId String?
  archiveReason            String?
  lastSeenAt               DateTime?
  archivedAt               DateTime?
  archivedByAdminId        String?
  archiveBlockedReason     String?
  city                     City?                @relation(fields: [cityId], references: [id])
  clientProfile            ClientProfile?
  performerProfile         PerformerProfile?
  clientRequests           ClientRequest[]      @relation("ClientRequests")
  managerCreatedRequests   ClientRequest[]      @relation("ManagerCreatedRequests")
  selectedRequests         ClientRequest[]      @relation("SelectedPerformerRequests")
  responses                RequestResponse[]
  chatsAsClient            Chat[]               @relation("ClientChats")
  chatsAsPerformer         Chat[]               @relation("PerformerChats")
  chatMessages             ChatMessage[]
  balanceTransactions      BalanceTransaction[] @relation("UserBalanceTransactions")
  paymentTransactions      PaymentTransaction[] @relation("UserPaymentTransactions")
  adminCreatedRefunds      RefundTransaction[]  @relation("AdminCreatedRefunds")
  receivedRefunds          RefundTransaction[]  @relation("UserRefundTransactions")
  adminCreatedTransactions BalanceTransaction[] @relation("AdminCreatedTransactions")
  complaintsFrom           Complaint[]          @relation("ComplaintsFrom")
  complaintsAgainst        Complaint[]          @relation("ComplaintsAgainst")
  riskFlags                UserRiskFlag[]
  reviewsFrom              Review[]             @relation("ReviewsFrom")
  reviewsTo                Review[]             @relation("ReviewsTo")
  auditLogs                AuditLog[]           @relation("ActorAuditLogs")
  consents                 Consent[]
  legalConsents            UserConsent[]        @relation("UserLegalConsents")
  createdLegalDocuments    LegalDocument[]      @relation("AdminCreatedLegalDocuments")
  consentAuditLogs         UserConsentAuditLog[] @relation("UserConsentAuditLogs")
  adminConsentAuditLogs    UserConsentAuditLog[] @relation("AdminConsentAuditLogs")
  adminConsentExports      ConsentExportLog[]   @relation("AdminConsentExports")
  userConsentExports       ConsentExportLog[]   @relation("UserConsentExports")
  performerDocuments       PerformerDocument[]
  identities               UserIdentity[]
  userCities               UserCity[]
  activatedCities          City[]               @relation("CityActivatedBy")
  npdTaxEntries            NpdTaxRegisterEntry[] @relation("UserNpdTaxEntries")
  npdRecordedEntries       NpdTaxRegisterEntry[] @relation("AdminRecordedNpdTaxEntries")
  createdCategoryStructures CategoryStructure[] @relation("CategoryStructureCreatedBy")
  publishedCategoryStructures CategoryStructure[] @relation("CategoryStructurePublishedBy")
  helperCategoryPreferences HelperCategoryPreference[] @relation("HelperCategoryPreferences")
  serviceConversation       ServiceConversation?
  receivedServiceMessages   ServiceMessage[] @relation("ServiceMessageRecipient")
  sentServiceMessages       ServiceMessage[] @relation("ServiceMessageSender")
  createdBroadcastCampaigns BroadcastCampaign[] @relation("BroadcastCreatedBy")
  broadcastRecipients       BroadcastRecipient[]
  serviceMessageAttachments ServiceMessageAttachment[] @relation("ServiceAttachmentOwner")
  uploadedServiceAttachments ServiceMessageAttachment[] @relation("ServiceAttachmentUploader")
  requestDrafts              RequestDraft[]              @relation("RequestDraftOwner")
  requestDraftSupportCases   RequestDraftSupportCase[]   @relation("RequestDraftSupportClient")
  assignedDraftSupportCases  RequestDraftSupportCase[]   @relation("RequestDraftSupportManager")
  authSessions               AuthSession[]

  @@index([role])
  @@index([cityId])
  @@index([status])
  @@index([blockedByAdminId])
  @@index([managerAssignedByAdminId])
  @@index([archiveRequestedAt])
  @@index([archivedAt])
}

model UserCity {
  id        String   @id @default(cuid())
  userId    String
  cityId    String
  roleScope String   @default("both")
  isPrimary Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city      City     @relation(fields: [cityId], references: [id])

  @@unique([userId, cityId])
  @@index([userId, isPrimary, isActive])
  @@index([cityId, roleScope, isActive])
}

model UserIdentity {
  id               String   @id @default(cuid())
  userId           String
  provider         String
  providerUserId   String
  email            String?
  displayName      String?
  avatarUrl        String?
  rawProfileJson   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@index([provider])
}

model ClientProfile {
  userId                 String  @id
  fullName               String?
  preferredContactMethod String  @default("chat")
  rating                 Float   @default(0)
  completedRequestsCount Int     @default(0)
  complaintsCount        Int     @default(0)
  notes                  String?
  user                   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PerformerProfile {
  userId                          String  @id
  age                             Int?
  about                           String?
  experience                      String?
  services                        String  @default("[]")
  skills                          String  @default("[]")
  limitations                     String?
  schedule                        String?
  districts                       String  @default("[]")
  canTravelIndependently          Boolean @default(false)
  canTravelOutsideCity            Boolean @default(false)
  readyForHygieneHelp             Boolean @default(false)
  readyForPhysicalHelp            Boolean @default(false)
  readyForLimitedMobility         Boolean @default(false)
  readyForChildren                Boolean @default(false)
  readyForUrgentRequests          Boolean @default(false)
  readyToProvideDocuments         Boolean @default(false)
  selfEmployedStatus              String  @default("self_employed_not_provided")
  criminalRecordCertificateStatus String  @default("criminal_record_not_provided")
  verificationStatuses            String  @default("[\"documents_optional\"]")
  childcareApprovalStatus         String  @default("not_requested")
  trustLevel                      String  @default("new_profile")
  rating                          Float   @default(0)
  completedJobsCount              Int     @default(0)
  complaintsCount                 Int     @default(0)
  isAvailable                     Boolean @default(true)
  profileComment                  String?
  notes                           String?
  user                            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ServiceCategory {
  id                     String          @id @default(cuid())
  name                   String
  slug                   String          @unique
  description            String?
  includedJson           String          @default("[]")
  excludedJson           String          @default("[]")
  complexityJson         String          @default("{}")
  transferRules          String?
  medicalProhibitions    String?
  clientInstructions     String?
  performerInstructions  String?
  pricingRulesJson       String          @default("{}")
  basePrice              Int             @default(0)
  calculationUnit        String          @default("hour")
  minDurationHours       Float           @default(1)
  sortOrder              Int             @default(100)
  isActive               Boolean         @default(true)
  isChildcare            Boolean         @default(false)
  requiresCriminalRecord Boolean         @default(false)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  requests               ClientRequest[]

  @@index([isActive])
}

model CategoryStructure {
  id                   String              @id @default(cuid())
  scopeType            String
  scopeRegionId        String?
  scopeCityId          String?
  scopeKey             String
  parentStructureId    String?
  versionNumber        String
  title                String
  description          String?
  status               String              @default("draft")
  qualityStatus        String              @default("draft")
  source               String              @default("manual")
  createdByAdminId     String?
  publishedByAdminId   String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  publishedAt          DateTime?
  activatedAt          DateTime?
  archivedAt           DateTime?
  emergencyDisabledAt  DateTime?
  emergencyDisabledByAdminId String?
  emergencyDisableReason String?
  comment              String?
  importFileName       String?
  importHash           String?
  metadataJson         String?
  schemaVersion        String              @default("2")
  scopeRegion          Region?             @relation(fields: [scopeRegionId], references: [id], onDelete: SetNull)
  scopeCity            City?               @relation(fields: [scopeCityId], references: [id], onDelete: SetNull)
  parentStructure      CategoryStructure?  @relation("CategoryStructureVersions", fields: [parentStructureId], references: [id], onDelete: SetNull)
  derivedStructures    CategoryStructure[] @relation("CategoryStructureVersions")
  createdByAdmin       User?               @relation("CategoryStructureCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  publishedByAdmin     User?               @relation("CategoryStructurePublishedBy", fields: [publishedByAdminId], references: [id], onDelete: SetNull)
  categories           Category[]
  requestSnapshots     RequestCategorySnapshot[]
  requestUpdateRevisions RequestStructureUpdateRevision[]
  serviceNodes         ServiceNode[]
  serviceNodeRelations ServiceNodeRelation[]
  serviceNodePricingRules ServiceNodePricingRule[]
  serviceNodeSafetyRules ServiceNodeSafetyRule[]
  requestDrafts        RequestDraft[]

  @@unique([scopeKey, versionNumber])
  @@index([scopeType, status])
  @@index([scopeRegionId, status])
  @@index([scopeCityId, status])
  @@index([parentStructureId])
}

model ServiceNode {
  id                     String   @id @default(cuid())
  structureId            String
  parentId               String?
  slug                   String
  stableKey              String
  nodeType               String   @default("task")
  title                  String
  descriptionForCustomer String?
  descriptionForHelper   String?
  sortOrder              Int      @default(100)
  isActive               Boolean  @default(true)
  isSelectable           Boolean  @default(false)
  isVisible              Boolean  @default(true)
  selectionMode          String   @default("multiple")
  aliasesJson            String   @default("[]")
  formFieldsJson         String   @default("[]")
  constraintsJson        String   @default("{}")
  durationEffectJson     String   @default("{}")
  metadataJson           String   @default("{}")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  structure              CategoryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  parent                 ServiceNode? @relation("ServiceNodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children               ServiceNode[] @relation("ServiceNodeTree")
  outgoingRelations      ServiceNodeRelation[] @relation("ServiceNodeRelationSource")
  incomingRelations      ServiceNodeRelation[] @relation("ServiceNodeRelationTarget")
  pricingRules           ServiceNodePricingRule[]
  safetyRules            ServiceNodeSafetyRule[]

  @@unique([structureId, slug])
  @@unique([structureId, stableKey])
  @@index([structureId, parentId, sortOrder])
  @@index([structureId, nodeType, isActive])
}

model ServiceNodeRelation {
  id              String   @id @default(cuid())
  structureId     String
  sourceNodeId    String?
  targetNodeId    String?
  sourceSlug      String
  targetSlug      String
  relationType    String
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(100)
  conditionsJson  String   @default("{}")
  pricingBehavior String?
  uiBehavior      String?
  metadataJson    String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  structure       CategoryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  sourceNode      ServiceNode? @relation("ServiceNodeRelationSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode      ServiceNode? @relation("ServiceNodeRelationTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([structureId, sourceSlug, targetSlug, relationType])
  @@index([structureId, relationType, isActive])
  @@index([sourceNodeId, isActive])
  @@index([targetNodeId, isActive])
}

model ServiceNodePricingRule {
  id                     String   @id @default(cuid())
  structureId            String
  nodeId                 String?
  nodeSlug               String
  packageCode            String?
  coveredNodeSlugsJson   String   @default("[]")
  recommendedMinPrice    Int?
  recommendedMaxPrice    Int?
  defaultDurationMinutes Int?
  priceComment           String?
  conditionsJson         String   @default("{}")
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  structure              CategoryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  node                   ServiceNode? @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([structureId, isActive])
  @@index([nodeId, isActive])
}

model ServiceNodeSafetyRule {
  id                String   @id @default(cuid())
  structureId       String
  nodeId            String?
  nodeSlug          String?
  ruleKey           String
  title             String
  description       String
  severity          String   @default("warning")
  isBlocking        Boolean  @default(false)
  applicabilityJson String   @default("{}")
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(100)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  structure         CategoryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  node              ServiceNode? @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([structureId, ruleKey])
  @@index([structureId, isActive, sortOrder])
  @@index([nodeId, isActive])
}

model Category {
  id                     String                 @id @default(cuid())
  structureId            String
  parentId               String?
  slug                   String
  title                  String
  shortTitle             String?
  descriptionForCustomer String?
  descriptionForHelper   String?
  descriptionForManager  String?
  descriptionForAdmin    String?
  icon                   String?
  level                  Int                    @default(0)
  sortOrder              Int                    @default(100)
  status                 String                 @default("active")
  isVisibleForCustomer   Boolean                @default(true)
  isVisibleForHelper     Boolean                @default(true)
  isVisibleForManager    Boolean                @default(true)
  isVisibleForAdmin      Boolean                @default(true)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  structure              CategoryStructure      @relation(fields: [structureId], references: [id], onDelete: Cascade)
  parent                 Category?              @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children               Category[]             @relation("CategoryTree")
  taskTemplates          CategoryTaskTemplate[]
  safetyRules            CategorySafetyRule[]
  pricingRules           CategoryPricingRule[]
  helperPreferences      HelperCategoryPreference[]
  snapshotsAsCategory    RequestCategorySnapshot[] @relation("SnapshotCategory")
  snapshotsAsSubcategory RequestCategorySnapshot[] @relation("SnapshotSubcategory")

  @@unique([structureId, slug])
  @@index([structureId, parentId, sortOrder])
  @@index([status])
}

model CategoryTaskTemplate {
  id             String                    @id @default(cuid())
  categoryId     String
  slug           String
  title          String
  description    String?
  customerHint   String?
  helperHint     String?
  managerHint    String?
  safetyNote     String?
  taskKind       String                    @default("standard")
  aliasesJson    String                    @default("[]")
  durationEffectJson String                @default("{}")
  priceEffectJson String                   @default("{}")
  requiresComment Boolean                 @default(false)
  allowedRegionsJson String               @default("[]")
  formFieldsJson String                   @default("[]")
  recommendationsJson String              @default("[]")
  constraintsJson String                  @default("{}")
  sortOrder      Int                       @default(100)
  isActive       Boolean                   @default(true)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  category       Category                  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  pricingRules   CategoryPricingRule[]
  requestSnapshots RequestCategorySnapshot[]

  @@unique([categoryId, slug])
  @@index([categoryId, isActive, sortOrder])
}

model CategorySafetyRule {
  id              String   @id @default(cuid())
  categoryId      String
  ruleKey         String   @default("")
  title           String
  description     String
  severity        String   @default("warning")
  isBlocking      Boolean  @default(false)
  applicabilityJson String @default("{}")
  isActive        Boolean  @default(true)
  showToCustomer  Boolean  @default(true)
  showToHelper    Boolean  @default(true)
  showToManager   Boolean  @default(true)
  sortOrder       Int      @default(100)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, sortOrder])
  @@index([categoryId, ruleKey, isActive])
}

model CategoryPricingRule {
  id                     String   @id @default(cuid())
  categoryId             String
  taskTemplateId         String?
  recommendedPackageCode String?
  recommendedMinPrice    Int?
  recommendedMaxPrice    Int?
  defaultDurationMinutes Int?
  priceComment           String?
  coveredTaskSlugsJson   String   @default("[]")
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  category               Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  taskTemplate           CategoryTaskTemplate? @relation(fields: [taskTemplateId], references: [id], onDelete: Cascade)

  @@index([categoryId, isActive])
  @@index([taskTemplateId, isActive])
}

model HelperCategoryPreference {
  id           String   @id @default(cuid())
  helperUserId String
  cityId       String?
  categoryId   String
  categorySlug String
  isEnabled    Boolean  @default(true)
  comment      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  helper       User     @relation("HelperCategoryPreferences", fields: [helperUserId], references: [id], onDelete: Cascade)
  city         City?    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([helperUserId, cityId, categoryId])
  @@index([helperUserId, cityId, isEnabled])
  @@index([categorySlug])
}

model RequestCategorySnapshot {
  id             String                @id @default(cuid())
  requestId      String
  structureId    String
  categoryId     String?
  subcategoryId  String?
  taskTemplateId String?
  snapshotJson   String
  createdAt      DateTime              @default(now())
  request        ClientRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  structure      CategoryStructure     @relation(fields: [structureId], references: [id])
  category       Category?             @relation("SnapshotCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory    Category?             @relation("SnapshotSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  taskTemplate   CategoryTaskTemplate? @relation(fields: [taskTemplateId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([structureId])
}

model ClientRequest {
  id                     String               @id @default(cuid())
  publicNumber           String?
  seedKey                String?              @unique
  clientId               String
  createdByRole          String?
  createdByManagerId     String?
  cityId                 String
  categoryId             String
  contactName            String?
  contactPhone           String?
  helpFor                String?
  additionalActionsJson  String               @default("[]")
  dependentStateJson     String               @default("[]")
  dependentAge           Int?
  scheduleType           String               @default("once")
  regularPeriod          String?
  repeatedVisitsAllowed  Boolean              @default(false)
  title                  String
  description            String
  addressText            String
  approximateAddressText String
  addressCity            String?
  addressStreet          String?
  addressHouse           String?
  addressApartment       String?
  addressEntrance        String?
  addressFloor           String?
  addressIntercom        String?
  addressComment         String?
  fullAddress            String?
  publicAddress          String?
  yandexPublicMapAddress String?
  yandexExactMapAddress  String?
  lat                    Float?
  lng                    Float?
  approximateLat         Float?
  approximateLng         Float?
  mapPrivacyRadiusMeters Int                  @default(600)
  district               String?
  date                   DateTime?
  timeFrom               String?
  timeTo                 String?
  expectedDurationHours  Float?
  urgency                String               @default("normal")
  hasElderlyPerson       Boolean              @default(false)
  hasChild               Boolean              @default(false)
  hasLimitedMobility     Boolean              @default(false)
  physicalHelpLevel      String?
  needsCooking           Boolean              @default(false)
  needsCleaning          Boolean              @default(false)
  needsWalk              Boolean              @default(false)
  needsHygieneHelp       Boolean              @default(false)
  hasPets                Boolean              @default(false)
  budgetAmount           Int?
  priceEstimateAmount    Int?
  pricingBreakdownJson   String?
  comment                String?
  status                 String               @default("draft")
  visibilityStatus       String               @default("private")
  selectedPerformerId    String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  completedAt            DateTime?
  cancelledAt            DateTime?
  archivedAt             DateTime?
  isHiddenFromPerformers Boolean              @default(false)
  hiddenReason           String?
  structureUpdatePendingAt DateTime?
  client                 User                 @relation("ClientRequests", fields: [clientId], references: [id])
  createdByManager       User?                @relation("ManagerCreatedRequests", fields: [createdByManagerId], references: [id], onDelete: SetNull)
  city                   City                 @relation(fields: [cityId], references: [id])
  category               ServiceCategory      @relation(fields: [categoryId], references: [id])
  selectedPerformer      User?                @relation("SelectedPerformerRequests", fields: [selectedPerformerId], references: [id])
  responses              RequestResponse[]
  chats                  Chat[]
  complaints             Complaint[]
  reviews                Review[]
  balanceTransactions    BalanceTransaction[]
  categorySnapshots      RequestCategorySnapshot[]
  agreementVersions      AgreementVersion[]
  agreementContracts     AgreementContract[]
  visits                 RequestVisit[]
  serviceFeeBatches      ServiceFeeAgreementBatch[]
  visitDisputes          RequestVisitDispute[]
  serviceMessages        ServiceMessage[]
  serviceAttachments     ServiceMessageAttachment[]
  structureUpdateRevisions RequestStructureUpdateRevision[]
  sourceDraft             RequestDraft?

  @@index([cityId, status])
  @@index([publicNumber])
  @@index([clientId])
  @@index([createdByManagerId])
  @@index([selectedPerformerId])
}

model RequestDraft {
  id                       String   @id @default(cuid())
  userId                   String
  cityId                   String?
  structureId              String?
  convertedRequestId       String?  @unique
  status                   String   @default("active")
  title                    String?
  formDataJson             String   @default("{}")
